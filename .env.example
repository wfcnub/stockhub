# Local development. Copy to .env (gitignored) and set a password. Never commit .env.
# For the deployment guest use deploy/.env.example instead.
POSTGRES_USER=stockhub
# Use only letters and digits so the DATABASE_URL needs no escaping, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=
POSTGRES_DB=stockhub
DB_PORT=5432
