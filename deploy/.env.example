# Deployment settings for /opt/stockhub/.env on the StockHub guest.
# Copy to /opt/stockhub/.env, chmod 600, fill in. Never commit the real file.
POSTGRES_USER=stockhub
# Letters and digits only (no URL escaping needed): `openssl rand -hex 24`. Never the dev password.
POSTGRES_PASSWORD=
POSTGRES_DB=stockhub
# STOCKHUB_TAG is written by deploy.sh to /opt/stockhub/release.env, not set here.
